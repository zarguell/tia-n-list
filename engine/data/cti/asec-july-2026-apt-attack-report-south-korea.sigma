title: Suspicious LNK File Launching PowerShell and AutoIt via Task Scheduler
id: a3c7e8f2-1d4b-4a9c-b5e6-7f8a9b0c1d2e
status: experimental
description: Detects LNK shortcut files that extract hex-encoded payloads to stage PowerShell and AutoIt binaries, followed by Task Scheduler persistence masquerading as OneDrive updates. Derived from ASEC July 2026 APT report on South Korean spearphishing campaigns.
references:
  - https://asec.ahnlab.com/july-2026-apt-report
  - https://www.malware.news/asec-july-2026-apt-south-korea
author: Tia N. List
date: 2026-08-28
tags:
  - attack.t1566.001
  - attack.t1059
  - attack.t1053
  - attack.t1105
logsource:
  category: process_creation
  product: windows
detection:
  selection_scheduled_task:
    EventID: 4698
    TaskName|contains:
      - 'OneDrive'
      - 'onedrive'
      - 'OneDriveUpdate'
  selection_autoit:
    EventID: 1
    Image|endswith:
      - '\AutoIt3.exe'
      - '\autoit3.exe'
      - '\SciTE.exe'
    ParentImage|endswith:
      - '\powershell.exe'
      - '\cmd.exe'
      - '\wscript.exe'
      - '\cscript.exe'
  selection_powershell_hex:
    EventID: 4104
    ScriptBlockText|contains:
      - 'ConvertFrom-HexString'
      - '[System.Convert]::FromBase64String'
      - 'Out-File -Encoding'
      - 'Invoke-Expression'
      - 'IEX('
      - 'Set-Content -Path'
  selection_pubnub:
    EventID: 1
    DestinationHostname|contains:
      - 'pubnub'
  condition: selection_scheduled_task or selection_autoit or selection_powershell_hex or selection_pubnub
falsepositives:
  - Legitimate AutoIt deployments
  - Standard OneDrive update mechanisms
level: high
