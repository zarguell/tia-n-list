title: DeadLock Ransomware Pre-Encryption Tripwires
id: 3b72e539-2be3-4d9b-bc47-96f5028acb22
status: experimental
description: >
    Detects the pre-encryption tripwires documented for the DeadLock
    ransomware operation (Microsoft Threat Intelligence, 2026-08-10):
    Windows Defender tampering, backup deletion and event log clearing
    that fire before encryption begins.
references:
    - https://www.microsoft.com/en-us/security/blog/2026/08/10/deadlock-ransomware-breaking-down-a-rust-based-encryptor-with-decentralized-recovery-infrastructure/
author: Tia N. List
date: 2026/08/11
tags:
    - attack.t1486
    - attack.t1490
    - attack.t1562
    - attack.t1070
logsource:
    category: process_creation
    product: windows
detection:
    selection_vss:
        Image|endswith: '\vssadmin.exe'
        CommandLine|contains|all:
            - 'delete'
            - 'shadows'
    selection_wbadmin:
        Image|endswith: '\wbadmin.exe'
        CommandLine|contains|all:
            - 'delete'
            - 'backup'
    selection_logs:
        Image|endswith:
            - '\wevtutil.exe'
        CommandLine|contains:
            - 'cl '
            - 'clear-log'
            - 'clear log'
    selection_defender:
        Image|endswith:
            - '\sc.exe'
        CommandLine|contains|all:
            - 'stop'
            - 'WinDefend'
    condition: 1 of selection_*
falsepositives:
    - Legitimate scheduled backup and log maintenance
    - Administer shadow-copy cleanup on busy storage servers
level: high
