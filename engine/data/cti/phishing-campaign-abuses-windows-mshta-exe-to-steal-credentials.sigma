title: Mshta.exe Phishing Campaign Credential Theft via HTA Files
id: b8c9d0e1-f2a3-4567-bcde-678901234567
status: experimental
description: Detects phishing campaigns abusing mshta.exe to execute HTA files for credential theft
references:
  - https://www.gbhackers.com/
  - https://cyberpress.org/
author: Tia N. List
date: 2026-09-12
tags:
  - attack.initial-access
  - attack.t1566
  - attack.stealth
  - attack.t1170
logsource:
  product: windows
  category: process_creation
detection:
  selection_mshta_execution:
    Image|endswith:
      - '\mshta.exe'
    CommandLine|contains:
      - '.hta'
      - 'vbscript'
      - 'jscript'
      - 'http'
  selection_mshta_from_email:
    ParentImage|endswith:
      - '\outlook.exe'
      - '\thunderbird.exe'
      - '\winmail.exe'
    Image|endswith:
      - '\mshta.exe'
  selection_mshta_suspicious:
    Image|endswith:
      - '\mshta.exe'
    CommandLine|contains:
      - 'javascript'
      - 'VBScript'
      - 'Execute'
      - 'CreateObject'
      - 'WScript.Shell'
  condition: selection_mshta_execution or selection_mshta_from_email or selection_mshta_suspicious
falsepositives:
  - Legitimate HTA application usage
level: high
