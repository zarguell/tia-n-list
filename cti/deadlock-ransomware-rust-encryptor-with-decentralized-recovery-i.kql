# deadlock-ransomware-rust-encryptor-with-decentralized-recovery-i — KQL variant (derived from deadlock-ransomware-rust-encryptor-with-decentralized-recovery-i.sigma via sigma convert)
(Image endswith "\\vssadmin.exe" and (CommandLine contains "delete" and CommandLine contains "shadows")) or (Image endswith "\\wbadmin.exe" and (CommandLine contains "delete" and CommandLine contains "backup")) or (Image endswith "\\wevtutil.exe" and (CommandLine contains "cl " or CommandLine contains "clear-log" or CommandLine contains "clear log")) or (Image endswith "\\sc.exe" and (CommandLine contains "stop" and CommandLine contains "WinDefend"))
